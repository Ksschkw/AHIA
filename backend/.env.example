# AHIA backend environment template.
#
# Copy to .env and fill in real values. .env is gitignored; this file is not
# and must contain placeholders only, never a real credential.
#
#   cp .env.example .env
#
# Every variable listed here is declared in backend/src/ahia/core/config.py and
# documented in docs/PREREQUISITES.md section 3. Nothing outside that module may
# read the environment.
#
# Secret variables are marked [secret]. A placeholder that looks like a real key
# is a bug: secret scanners and reviewers both treat it as one.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                 # development | test | production
APP_NAME=AHIA
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                      # DEBUG is rejected outside development
LOG_FORMAT=json                     # json everywhere; console in development only
CORRELATION_ID_HEADER=X-Correlation-ID
TRUSTED_PROXY_COUNT=0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://REPLACE_ME:REPLACE_ME@127.0.0.1:5432/ahia_dev
# Optional. Leave empty to use DATABASE_URL; set it when migrations must reach a
# different endpoint from the pooled one the application uses.
DATABASE_MIGRATION_URL=
DATABASE_REQUIRE_SSL=false          # must be true in staging and production
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Test database used by the integration test suite. Never points at
# development or production data.
TEST_DATABASE_URL=postgresql+asyncpg://REPLACE_ME:REPLACE_ME@127.0.0.1:5432/ahia_test

# ---------------------------------------------------------------------------
# Authentication and sessions
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-32-bytes-of-random-entropy          # [secret]
JWT_ALGORITHM=HS256
JWT_ISSUER=ahia-api
JWT_AUDIENCE=ahia-clients
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_PEPPER=replace-with-32-bytes-of-random-entropy # [secret]
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2
PASSWORD_MIN_LENGTH=8

# ---------------------------------------------------------------------------
# Transport security
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ALLOW_CREDENTIALS=true
HSTS_MAX_AGE_SECONDS=31536000
CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'; base-uri 'none'
SECURITY_HEADERS_ENABLED=true

# ---------------------------------------------------------------------------
# Rate limiting - always on, configuration only, never a feature flag
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_WRITE_PER_MINUTE=120
RATE_LIMIT_GLOBAL_PER_MINUTE=600

# ---------------------------------------------------------------------------
# Storage and media
#
# Storage is provider-neutral. STORAGE_PROVIDER is the only switch between
# Cloudflare R2 and Cloudinary; the inactive provider's credentials are neither
# required nor validated. No credentials are ever hard-coded, and the storage
# provider is never accepted from a client request.
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=r2                  # r2 | cloudinary
STORAGE_SIGNED_URL_TTL_SECONDS=900

# Upload and media limits. All enforced server-side; none of them are advisory.
MAX_UPLOAD_SIZE_MB=5                 # absolute ceiling for any upload
MAX_PRODUCT_IMAGE_SIZE_MB=5          # product image ceiling, never above the above
MAX_PRODUCT_IMAGE_WIDTH=2000         # larger images are resized down, never upscaled
MAX_PRODUCT_IMAGE_HEIGHT=2000
MAX_PRODUCT_IMAGES_PER_PRODUCT=10
MAX_TENANT_STORAGE_MB=500            # per-tenant quota, enforced by AHIA itself
MEDIA_TARGET_FORMAT=webp             # webp | jpeg | png | avif
MEDIA_IMAGE_QUALITY=82
MEDIA_STRIP_METADATA=true            # removes EXIF, GPS and device metadata
MEDIA_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/avif

# Cloudflare R2 - used when STORAGE_PROVIDER=r2
R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_ME                                  # [secret]
R2_SECRET_ACCESS_KEY=REPLACE_ME                              # [secret]
R2_BUCKET=ahia-dev
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_REQUEST_TIMEOUT_SECONDS=10

# Cloudinary - used when STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME                                # [secret]
CLOUDINARY_API_SECRET=REPLACE_ME                             # [secret]
CLOUDINARY_UPLOAD_FOLDER=ahia
CLOUDINARY_SECURE_DELIVERY=true
CLOUDINARY_REQUEST_TIMEOUT_SECONDS=15

# Storage resilience policy. One set for the active provider: a circuit breaker
# is per dependency, and switching providers must not silently change how
# forgiving the outbound boundary is.
STORAGE_MAX_CONCURRENT_CALLS=8
STORAGE_RETRY_MAX_ATTEMPTS=3
STORAGE_CIRCUIT_FAILURE_THRESHOLD=5
STORAGE_CIRCUIT_RESET_SECONDS=60

# ---------------------------------------------------------------------------
# Public sharing and messaging - required from milestone M16
# ---------------------------------------------------------------------------
DEFAULT_PHONE_COUNTRY_CODE=234        # country code applied to local phone numbers
PUBLIC_WEB_BASE_URL=http://localhost:3000
WHATSAPP_CLICK_TO_CHAT_BASE_URL=https://wa.me
WHATSAPP_DEFAULT_COUNTRY_CODE=234
PUBLIC_TOKEN_BYTES=24

# ---------------------------------------------------------------------------
# Feature flags
#
# Booleans only. Security controls are never listed here: authentication,
# authorization, input validation, rate limiting and logging are always on.
# Every flag carries a date added and a removal condition in
# docs/PREREQUISITES.md section 4 and is logged once at startup.
# ---------------------------------------------------------------------------
FEATURE_OFFLINE_SYNC=false
FEATURE_STOREFRONT_PUBLIC_PUBLISHING=false
FEATURE_MEDIA_UPLOAD=false
FEATURE_WHATSAPP_CLICK_TO_CHAT=false
FEATURE_AI_INSIGHTS=false
FEATURE_SUPPLIER_MODULE=false
FEATURE_TRACKING_MODULE=false
FEATURE_NETWORK_MODULE=false

{
  "expo": {
    "name": "AHIA",
    "slug": "ahia",
    "scheme": "ahia",
    "version": "0.4.10",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f3ec"
    },
    "android": {
      "package": "app.ahia.mobile",
      "versionCode": 15,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b5d3b"
      },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "app.ahia.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b0446c79-ca32-4ca7-83cf-dd0fe3f0e01e"
      }
    },
    "owner": "ksschkw"
  }
}

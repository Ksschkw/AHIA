# Normalize line endings and mark generated files for GitHub Linguist.
* text=auto eol=lf

*.py text diff=python
*.md text
*.yml text
*.yaml text
*.toml text
*.ini text
*.cfg text
*.sh text eol=lf
Makefile text eol=lf

# Binary assets are never merged as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Lockfiles are generated. They are reviewed, not hand-edited, and they are
# excluded from diffstat noise and merge conflict resolution.
*lock.json linguist-generated=true
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
requirements.lock linguist-generated=true
uv.lock linguist-generated=true
